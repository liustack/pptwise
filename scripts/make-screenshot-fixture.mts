/**
 * The portrait screen, as a stack of this repository's own components under a
 * phone's own chrome.
 *
 * Not a slide: a slide is `viewBox="0 0 1280 720"` by construction and no face
 * is 9:19, so `renderSlideSvg` cannot draw a phone screen at all. Feeding the
 * landscape dashboard to the phone frame instead produced a portrait slice of
 * a desktop layout — a cropped chart and half a KPI card — which read as a
 * browser someone had squeezed, not as an app. The components are the same
 * ones the desktop page uses, rendered by the same `renderComponent`; what
 * this adds is the phone-shaped column they stack in, and the status bar,
 * header and tab bar that say "app" rather than "page".
 */
export const PHONE_SCREEN = {
  theme: "enterprise",
