/**
 * Regenerates the two product screenshots the gallery's `device_mockup`
 * specimens are framed around:
 *
 *   screenshot-1.jpg        1280x720   a desktop dashboard, behind the browser
 *   screenshot-phone-1.jpg   720x1520  a mobile app, behind the phone
 *
 * The asset these replaced was generated by an image model with a prompt that
 * asked for the letters to be unreadable, so every mockup in the review matrix
 * was a soft blob and no reviewer could tell a crisp frame from a blurry one.
 * Both are drawn here by this repository's own renderers instead.
 *
 *   pnpm tsx scripts/make-screenshot-fixture.mts
 */

import { createHash } from "node:crypto"
import { createElement, type ReactElement, type ReactNode } from "react"
import { mkdirSync, writeFileSync } from "node:fs"
import { dirname, resolve } from "node:path"
import { fileURLToPath } from "node:url"
import sharp from "sharp"
import type { Component, PptxIR } from "../src/ir"
import { renderSlideSvg, validateIr } from "../src/api"
import { measureComponent, renderComponent } from "../src/components"
import { buildCtx } from "../src/render/full-slide-svg"
import { renderSvgMarkup } from "../src/render/serialize"
import { resolveStyle } from "../src/themes"
import { installNodePlatform } from "../src/platform/node"
import { getPlatform } from "../src/platform/registry"
import { CANVAS_H_PX, CANVAS_W_PX } from "../src/constants"

/**
 * Every sharp JPEG option that moves the encoded bytes, named explicitly
 * rather than left to a library default.
 *
 * Recording only quality and chroma left the rest of the recipe implicit, and
 * a default that changed under us — or a hand-added `progressive` — would have
 * rewritten the file with nothing saying what moved. Measured on this fixture:
 * progressive costs 5.7% of the size, turning off Huffman optimisation adds
 * 17.9%, mozjpeg defaults cut 26.2%. All of them are pinned and digested.
 */
export const RECIPE = {
  quality: 88,
  progressive: false,
  chromaSubsampling: "4:4:4",
  optimiseCoding: true,
  trellisQuantisation: false,
  overshootDeringing: false,
  optimiseScans: false,
  quantisationTable: 0,
  mozjpeg: false,
} as const

/** Both fixtures share one product, so the gallery reads as one company. */
const PRODUCT = "云雀增长看板"
const PRODUCT_SUB = "近三十天核心指标"

